<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 1. Настройка вывода в КОНСОЛЬ (с красивой подсветкой уровней) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%X{username}] %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Настройка вывода в ФАЙЛ (с авто-архивацией старых логов) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/javatracker.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Старые логи будут складываться в архив по дням -->
            <fileNamePattern>logs/archived/javatracker-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Каждый файл максимум 10 Мегабайт -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Хранить историю логов за последние 30 дней -->
            <maxHistory>30</maxHistory>
            <!-- Общий лимит всех архивов на диске — 1 Гигабайт -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{username}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 3. Корневой уровень логирования для всего приложения -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- 4. Для наших собственных классов включаем подробный DEBUG режим -->
    <logger name="com.example" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

</configuration>